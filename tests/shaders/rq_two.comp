#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneA;
layout(set = 0, binding = 3) uniform accelerationStructureEXT sceneB;
layout(set = 0, binding = 2, std430) buffer Res { float res[]; };

// two live queries against two different acceleration structures
void main() {
  uint i = gl_GlobalInvocationID.x;
  rayQueryEXT qa, qb;
  vec3 o = vec3(float(i), 0.0, 0.0);
  rayQueryInitializeEXT(qa, sceneA, gl_RayFlagsOpaqueEXT, 0xFF, o, 0.0, vec3(0, 0, 1), 100.0);
  rayQueryInitializeEXT(qb, sceneB, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.0, vec3(0, 1, 0), 50.0);
  while (rayQueryProceedEXT(qa)) { }
  while (rayQueryProceedEXT(qb)) { rayQueryConfirmIntersectionEXT(qb); }
  float t = 0.0;
  if (rayQueryGetIntersectionTypeEXT(qa, true) != gl_RayQueryCommittedIntersectionNoneEXT)
    t += rayQueryGetIntersectionTEXT(qa, true);
  if (rayQueryGetIntersectionTypeEXT(qb, true) != gl_RayQueryCommittedIntersectionNoneEXT)
    t += rayQueryGetIntersectionTEXT(qb, true);
  mat4x3 m = rayQueryGetIntersectionObjectToWorldEXT(qa, true);
  res[i] = t + m[3].x + rayQueryGetWorldRayOriginEXT(qb).x + float(rayQueryGetIntersectionInstanceIdEXT(qb, true));
}
