#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) buffer Rays { float rays[]; };
layout(set = 0, binding = 2, std430) buffer Res { uint res[]; };
layout(set = 0, binding = 3, std430) buffer Boxes { float boxes[]; };  // 6 floats per box
layout(push_constant) uniform PC { uint count; uint flags; uint mask; } pc;

// Procedural geometry: the shader intersects the box itself (in object space) and generates
// the intersection, like the beam effects of Quake II RTX.
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) return;
  uint b = i * 8u;
  vec3 o = vec3(rays[b + 0u], rays[b + 1u], rays[b + 2u]);
  vec3 d = vec3(rays[b + 4u], rays[b + 5u], rays[b + 6u]);
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, pc.flags, pc.mask, o, rays[b + 3u], d, rays[b + 7u]);
  uint lastOpaque = 0u;
  while (rayQueryProceedEXT(rq)) {
    if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
      uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
      vec3 mn = vec3(boxes[prim * 6u + 0u], boxes[prim * 6u + 1u], boxes[prim * 6u + 2u]);
      vec3 mx = vec3(boxes[prim * 6u + 3u], boxes[prim * 6u + 4u], boxes[prim * 6u + 5u]);
      vec3 oo = rayQueryGetIntersectionObjectRayOriginEXT(rq, false);
      vec3 dd = rayQueryGetIntersectionObjectRayDirectionEXT(rq, false);
      vec3 inv = 1.0 / dd;
      vec3 t0 = (mn - oo) * inv, t1 = (mx - oo) * inv;
      vec3 tlo = min(t0, t1), thi = max(t0, t1);
      float tn = max(max(tlo.x, tlo.y), tlo.z), tf = min(min(thi.x, thi.y), thi.z);
      float t = max(tn, rayQueryGetRayTMinEXT(rq));
      if (t <= tf) {
        lastOpaque = rayQueryGetIntersectionCandidateAABBOpaqueEXT(rq) ? 1u : 0u;
        rayQueryGenerateIntersectionEXT(rq, t);
      }
    }
  }
  uint type = rayQueryGetIntersectionTypeEXT(rq, true);
  bool hit = type == gl_RayQueryCommittedIntersectionGeneratedEXT;
  res[b + 0u] = hit ? floatBitsToUint(rayQueryGetIntersectionTEXT(rq, true)) : 0u;
  res[b + 1u] = hit ? 1u : 0u;
  res[b + 2u] = hit ? uint(rayQueryGetIntersectionInstanceIdEXT(rq, true)) : 0u;
  res[b + 3u] = hit ? uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true)) : 0u;
  res[b + 4u] = hit ? uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)) : 0u;
  res[b + 5u] = hit ? lastOpaque : 0u;
  res[b + 6u] = type;  // must be 2 (generated) for a hit, 0 for a miss
  res[b + 7u] = hit ? uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)) : 0u;
}
