#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 2, std430) buffer Res { float res[]; };

// a ray query handed to another function: not supported yet, must fail cleanly
float firstHit(rayQueryEXT q) {
  while (rayQueryProceedEXT(q)) { }
  return rayQueryGetIntersectionTEXT(q, true);
}
void main() {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, scene, 0, 0xFF, vec3(0), 0.0, vec3(0, 0, 1), 10.0);
  res[gl_GlobalInvocationID.x] = firstHit(rq);
}
