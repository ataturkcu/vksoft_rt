#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
// Procedural geometry: one dispatch per geometry. Boxes are stored as leaf records with the
// same 48-byte stride as triangles (words 0..5 = box, 9 geometry index, 10 primitive index,
// 11 flags: bit0 opaque, bit1 procedural). Inactive boxes (min > max or NaN) get an empty box.
// a0 first box of this range (VkAabbPositionsKHR array), a3 leaf records out, a4 centroid bounds
// u0 count, u1 stride, u3 geometry index, u4 geometry flags
void main() {
  uint i = gl_GlobalInvocationID.x;
  uint lo[3] = uint[3](0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu);
  uint hi[3] = uint[3](0u, 0u, 0u);
  if (i < pc.u[0]) {
    uint64_t src = pc.a[0] + uint64_t(i) * uint64_t(pc.u[1]);
    float b[6];
    for (uint k = 0; k < 6; ++k) b[k] = ldf(src, k);
    bool ok = b[0] <= b[3] && b[1] <= b[4] && b[2] <= b[5];
    uint64_t rec = pc.a[3] + uint64_t(i) * uint64_t(TRI_BYTES);
    for (uint k = 0; k < 3; ++k) {
      stf(rec, k, ok ? b[k] : uintBitsToFloat(0x7F800000u));
      stf(rec, 3u + k, ok ? b[3u + k] : uintBitsToFloat(0xFF800000u));
    }
    st(rec, 6u, 0u); st(rec, 7u, 0u); st(rec, 8u, 0u);
    st(rec, 9u, pc.u[3]);
    st(rec, 10u, i);
    st(rec, 11u, (pc.u[4] & 1u) | 2u);
    if (ok)
      for (uint a = 0; a < 3; ++a) { lo[a] = f2o(0.5 * (b[a] + b[3u + a])); hi[a] = lo[a]; }
  }
  for (uint a = 0; a < 3; ++a) {
    uint mn = subgroupMin(lo[a]);
    uint mx = subgroupMax(hi[a]);
    if (subgroupElect()) {
      atomicMin(Words(pc.a[4]).v[a], mn);
      atomicMax(Words(pc.a[4]).v[3 + a], mx);
    }
  }
}
