#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
// a0 bounds, a1 flags[N], a2 parent[]; u0 = N
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < pc.u[0]) st(pc.a[1], i, 0u);
  if (i < 6u) st(pc.a[0], i, i < 3u ? 0xFFFFFFFFu : 0u);  // ordered min / max
  if (i == 0u) st(pc.a[2], 0u, NONE);  // root (N>1) or the single leaf (N==1)
}
