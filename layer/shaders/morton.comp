#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
// a0 triangles (u1=0) or 24 B box records (u1=1), a1 bounds, a2 keys out, a3 values out; u0 = N
uint expandBits(uint v) {
  v = (v * 0x00010001u) & 0xFF0000FFu;
  v = (v * 0x00000101u) & 0x0F00F00Fu;
  v = (v * 0x00000011u) & 0xC30C30C3u;
  v = (v * 0x00000005u) & 0x49249249u;
  return v;
}
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.u[0]) return;
  vec3 mn = vec3(o2f(ld(pc.a[1], 0)), o2f(ld(pc.a[1], 1)), o2f(ld(pc.a[1], 2)));
  vec3 mx = vec3(o2f(ld(pc.a[1], 3)), o2f(ld(pc.a[1], 4)), o2f(ld(pc.a[1], 5)));
  vec3 c = vec3(0);
  if (pc.u[1] == 0u) {
    uint64_t t = pc.a[0] + uint64_t(i) * uint64_t(TRI_BYTES);
    if ((ld(t, 11u) & 2u) != 0u) {  // procedural leaf: box in words 0..5, empty boxes sort last
      vec3 bmn = vec3(ldf(t, 0), ldf(t, 1), ldf(t, 2)), bmx = vec3(ldf(t, 3), ldf(t, 4), ldf(t, 5));
      if (bmn.x > bmx.x) {
        st(pc.a[2], i, 0xFFFFFFFFu);
        st(pc.a[3], i, i);
        return;
      }
      c = 0.5 * (bmn + bmx);
    } else {
      for (uint v = 0; v < 3; ++v)
        c += vec3(ldf(t, v * 3), ldf(t, v * 3 + 1), ldf(t, v * 3 + 2));
      c *= (1.0 / 3.0);
    }
  } else {
    uint64_t t = pc.a[0] + uint64_t(i) * 24ul;
    vec3 bmn = vec3(ldf(t, 0), ldf(t, 1), ldf(t, 2)), bmx = vec3(ldf(t, 3), ldf(t, 4), ldf(t, 5));
    if (bmn.x > bmx.x) {  // empty (inactive) box: sort to the end
      st(pc.a[2], i, 0xFFFFFFFFu);
      st(pc.a[3], i, i);
      return;
    }
    c = 0.5 * (bmn + bmx);
  }
  vec3 ext = max(mx - mn, vec3(1e-20));
  vec3 n = clamp((c - mn) / ext, 0.0, 1.0);
  uvec3 q = uvec3(min(n * 1024.0, vec3(1023.0)));
  uint code = (expandBits(q.x) << 2) | (expandBits(q.y) << 1) | expandBits(q.z);
  st(pc.a[2], i, code);
  st(pc.a[3], i, i);
}
